# Axodus Marketplace — Contracts (.env example)
# Copie este arquivo para `.env` dentro de `contracts/` e preencha os valores.

########################################
# Accounts / Keys
########################################
# Chave privada da carteira que fará deploys/txs (sem aspas). Use uma conta com fundos.
# Formato: 0x.... (64 hex)
PRIVATE_KEY=

########################################
# RPC endpoints (HTTP)
########################################
# URLs para as redes suportadas pelo Hardhat (usadas em hardhat.config.ts)
RPC_ETHEREUM=https://mainnet.infura.io/v3/${INFURA_KEY}
RPC_BNB=https://bsc-dataseed.binance.org
RPC_ARBITRUM=https://arb1.arbitrum.io/rpc
RPC_HARMONY=https://api.harmony.one
RPC_POLYGON=https://polygon-rpc.com

########################################
# RPC endpoints (WebSocket) — opcional
########################################
# Úteis para indexer/listener. Não necessários para compile/deploy básicos.
RPC_WS_ETHEREUM=wss://mainnet.infura.io/ws/v3/${INFURA_KEY}
RPC_WS_BNB=wss://bsc-ws-node.nariox.org:443
RPC_WS_ARBITRUM=wss://arb1.arbitrum.io/ws
RPC_WS_HARMONY=wss://ws.s0.t.hmny.io
RPC_WS_POLYGON=wss://polygon-rpc.com/ws

########################################
# Explorers API Keys (hardhat-verify / foundry)
########################################
# Necessários para verificação de contratos nos exploradores
ETHERSCAN_API_KEY=
BSCSCAN_API_KEY=
ARBISCAN_API_KEY=
POLYGONSCAN_API_KEY=

########################################
# Gas Reporter (opcional)
########################################
# Define para qualquer valor para habilitar o hardhat-gas-reporter
REPORT_GAS=
# Para preços em USD no gas-reporter
COINMARKETCAP_API_KEY=

########################################
# Foundry helpers (forge)
########################################
# Usado em foundry.toml para o endpoint da Ethereum via Infura
INFURA_KEY=

# LayerZero / OFT (opcional)
# Endpoint LayerZero para a rede alvo (ex.: Ethereum mainnet/Arbitrum/etc.)
LZ_ENDPOINT=
# Admin/owner para o OFTAdapter (se vazio, usa a mesma conta que faz o deploy)
OFT_ADMIN=

# Observações:
# - Deixe REPORT_GAS vazio ou remova para desabilitar o gas-reporter.
# - "harmony" já tem um default no hardhat.config.ts; definir RPC_HARMONY sobrescreve.
# - Para segurança, não commitar seu arquivo .env com segredos.
